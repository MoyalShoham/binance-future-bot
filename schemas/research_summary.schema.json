{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trading-system/schemas/research_summary.schema.json",
  "title": "Research Summary Schema",
  "description": "Normalized research output from Research Coordinator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "correlation_id",
    "timestamp",
    "symbol",
    "timeframe",
    "market_data",
    "sentiment",
    "analysis_timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version (semantic versioning)",
      "const": "1.0.0"
    },
    "agent_id": {
      "type": "string",
      "const": "research-coordinator",
      "description": "Originating agent identifier"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ID linking all messages in this trading cycle"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Message generation timestamp"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]+USDT$",
      "description": "Trading pair symbol (e.g., BTCUSDT, 1000SHIBUSDT)"
    },
    "timeframe": {
      "type": "string",
      "enum": ["1m", "3m", "5m", "15m", "30m", "1h", "4h", "1d"],
      "description": "Primary analysis timeframe"
    },
    "analysis_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this analysis was completed"
    },
    "market_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "volume_24h", "funding_rate"],
      "properties": {
        "price": {
          "type": "number",
          "minimum": 0,
          "description": "Current market price"
        },
        "volume_24h": {
          "type": "number",
          "minimum": 0,
          "description": "24-hour trading volume in USDT"
        },
        "price_change_24h_pct": {
          "type": "number",
          "description": "24-hour price change percentage"
        },
        "funding_rate": {
          "type": "number",
          "description": "Current perpetual funding rate"
        },
        "open_interest": {
          "type": "number",
          "minimum": 0,
          "description": "Total open interest in USDT"
        },
        "order_book": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bid_depth": {
              "type": "number",
              "minimum": 0,
              "description": "Total bid volume (top 10 levels)"
            },
            "ask_depth": {
              "type": "number",
              "minimum": 0,
              "description": "Total ask volume (top 10 levels)"
            },
            "imbalance_ratio": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "description": "Order book imbalance (-1 to 1, positive = bullish)"
            }
          }
        }
      }
    },
    "technical_indicators": {
      "type": "object",
      "properties": {
        "ema_9": {
          "type": "number",
          "description": "9-period Exponential Moving Average"
        },
        "ema_21": {
          "type": "number",
          "description": "21-period Exponential Moving Average"
        },
        "ema_50": {
          "type": "number",
          "description": "50-period Exponential Moving Average"
        },
        "vwap": {
          "type": "number",
          "description": "Volume Weighted Average Price"
        },
        "rsi": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Relative Strength Index"
        },
        "macd": {
          "type": "object",
          "properties": {
            "macd_line": {"type": "number"},
            "signal_line": {"type": "number"},
            "histogram": {"type": "number"}
          }
        },
        "atr": {
          "type": "number",
          "minimum": 0,
          "description": "Average True Range (volatility measure)"
        },
        "volatility_pct": {
          "type": "number",
          "minimum": 0,
          "description": "Percentage volatility (standard deviation)"
        }
      }
    },
    "sentiment": {
      "type": "object",
      "required": ["overall_score", "confidence"],
      "properties": {
        "overall_score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Aggregated sentiment score (-1 = bearish, 0 = neutral, 1 = bullish)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in sentiment analysis"
        },
        "sources": {
          "type": "object",
          "properties": {
            "news_sentiment": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "social_sentiment": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "whale_activity": {
              "type": "string",
              "enum": ["accumulation", "distribution", "neutral"]
            }
          }
        }
      }
    },
    "market_regime": {
      "type": "string",
      "enum": ["trending_up", "trending_down", "ranging", "high_volatility", "low_liquidity"],
      "description": "Current market regime classification"
    },
    "news_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "headline": {"type": "string"},
          "impact": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "sentiment": {
            "type": "string",
            "enum": ["positive", "negative", "neutral"]
          },
          "timestamp": {"type": "string", "format": "date-time"}
        }
      },
      "description": "Recent significant news events"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Risk warnings or notable conditions"
    },
    "time_decay_factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Freshness factor (1.0 = just generated, decays over time)"
    },
    "llm_enhancement": {
      "type": "object",
      "description": "Optional LLM-enhanced analysis insights",
      "properties": {
        "enhanced_sentiment": {
          "type": "object",
          "properties": {
            "score": {"type": "number", "minimum": -1, "maximum": 1},
            "interpretation": {"type": "string"},
            "key_drivers": {"type": "array", "items": {"type": "string"}}
          }
        },
        "pattern_insights": {"type": "array", "items": {"type": "string"}},
        "regime_reasoning": {"type": "string"},
        "additional_warnings": {"type": "array", "items": {"type": "string"}},
        "key_levels": {
          "type": "object",
          "properties": {
            "nearest_support": {"type": ["number", "null"]},
            "nearest_resistance": {"type": ["number", "null"]}
          }
        },
        "model_used": {"type": "string"},
        "llm_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
