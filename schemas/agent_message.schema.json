{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trading-system/schemas/agent_message.schema.json",
  "title": "Agent Message Base Schema",
  "description": "Base schema for all inter-agent communication messages",
  "type": "object",
  "required": ["agent_id", "timestamp", "schema_version", "message_type"],
  "properties": {
    "agent_id": {
      "type": "string",
      "enum": [
        "research-coordinator",
        "trading-decision",
        "risk-manager",
        "execution-agent",
        "storage-reporter",
        "emergency-controller"
      ],
      "description": "Unique identifier for the agent sending this message"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 formatted timestamp of message creation"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the schema (MAJOR.MINOR.PATCH)",
      "default": "1.0.0"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "research_summary",
        "trading_decision",
        "risk_approval",
        "execution_result",
        "storage_confirmation",
        "emergency_alert",
        "error"
      ],
      "description": "Type of message being sent"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID to track related messages across the pipeline"
    },
    "parent_message_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the message this is responding to"
    },
    "payload": {
      "type": "object",
      "description": "Message-specific data conforming to the message_type schema"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "model_used": {
          "type": "string",
          "description": "AI model used to generate this message"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence level in the decision/analysis"
        },
        "processing_time_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Time taken to process and generate this message"
        },
        "input_hash": {
          "type": "string",
          "description": "SHA-256 hash of input data for audit trail"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code identifier"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error description"
          },
          "severity": {
            "type": "string",
            "enum": ["warning", "error", "critical"],
            "default": "error"
          }
        }
      },
      "description": "Array of errors encountered during processing"
    }
  }
}
